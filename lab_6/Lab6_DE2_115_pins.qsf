# Lab 6 PC constraints for DE2-115 EP4CE115F29C7.
# Factory jumper settings: JP7 = 2.5 V, JP6 = 3.3 V.
# clk=KEY1; rst=SW9; instruction_A=SW2..0;
# RegWrite=SW3; MemWrite=SW4; beq_sw=SW8..5.
# Register digits HEX1..0; data-memory digits HEX3..2.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_location_assignment PIN_M21 -to clk
set_instance_assignment -name IO_STANDARD "2.5 V" -to clk
set_location_assignment PIN_AB25 -to rst
set_instance_assignment -name IO_STANDARD "2.5 V" -to rst
set_location_assignment PIN_AB28 -to instruction_A[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to instruction_A[0]
set_location_assignment PIN_AC28 -to instruction_A[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to instruction_A[1]
set_location_assignment PIN_AC27 -to instruction_A[2]
set_instance_assignment -name IO_STANDARD "2.5 V" -to instruction_A[2]
set_location_assignment PIN_AD27 -to RegWrite
set_instance_assignment -name IO_STANDARD "2.5 V" -to RegWrite
set_location_assignment PIN_AB27 -to MemWrite
set_instance_assignment -name IO_STANDARD "2.5 V" -to MemWrite
set_location_assignment PIN_AC26 -to beq_sw[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to beq_sw[0]
set_location_assignment PIN_AD26 -to beq_sw[1]
