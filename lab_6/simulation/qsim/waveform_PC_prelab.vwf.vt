initial 

begin 
$timeformat(-12,3," ps",6);
#1200000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module PC_vlg_vec_tst();
// constants                                           
// general purpose registers
reg MemWrite;
reg RegWrite;
reg [3:0] beq_sw;
reg clk;
reg [2:0] instruction_A;
reg rst;
// wires                                               
wire [13:0] data_probe_segments;
wire [7:0] data_probe_value;
wire [13:0] reg_probe_segments;
wire [7:0] reg_probe_value;

wire sampler;                             

// assign statements (if any)                          
PC i1 (
// port map - connection between master ports and signals/registers   
	.MemWrite(MemWrite),
	.RegWrite(RegWrite),
	.beq_sw(beq_sw),
	.clk(clk),
	.data_probe_segments(data_probe_segments),
	.data_probe_value(data_probe_value),
	.instruction_A(instruction_A),
	.reg_probe_segments(reg_probe_segments),
	.reg_probe_value(reg_probe_value),
	.rst(rst)
);

// clk
always
begin
	clk = 1'b0;
	clk = #25000 1'b1;
	#25000;
end 

// rst
initial
begin
	rst = 1'b0;
	rst = #50000 1'b1;
end 
// instruction_A[ 2 ]
initial
begin
	instruction_A[2] = 1'b0;
	instruction_A[2] = #550000 1'b1;
	instruction_A[2] = #100000 1'b0;
	instruction_A[2] = #50000 1'b1;
	instruction_A[2] = #100000 1'b0;
	instruction_A[2] = #200000 1'b1;
	instruction_A[2] = #100000 1'b0;
end 
// instruction_A[ 1 ]
initial
begin
	instruction_A[1] = 1'b0;
	instruction_A[1] = #250000 1'b1;
	instruction_A[1] = #100000 1'b0;
	instruction_A[1] = #50000 1'b1;
	instruction_A[1] = #100000 1'b0;
	instruction_A[1] = #350000 1'b1;
	instruction_A[1] = #100000 1'b0;
end 
// instruction_A[ 0 ]
initial
begin
	instruction_A[0] = 1'b0;
	instruction_A[0] = #100000 1'b1;
	instruction_A[0] = #100000 1'b0;
	instruction_A[0] = #200000 1'b1;
	instruction_A[0] = #100000 1'b0;
	instruction_A[0] = #200000 1'b1;
	instruction_A[0] = #100000 1'b0;
	instruction_A[0] = #50000 1'b1;
	instruction_A[0] = #100000 1'b0;
	instruction_A[0] = #50000 1'b1;
	instruction_A[0] = #100000 1'b0;
end 

// RegWrite
initial
begin
	RegWrite = 1'b0;
	RegWrite = #100000 1'b1;
	RegWrite = #100000 1'b0;
	RegWrite = #200000 1'b1;
	RegWrite = #100000 1'b0;
	RegWrite = #50000 1'b1;
	RegWrite = #100000 1'b0;
	RegWrite = #50000 1'b1;
	RegWrite = #100000 1'b0;
	RegWrite = #50000 1'b1;
	RegWrite = #100000 1'b0;
	RegWrite = #50000 1'b1;
	RegWrite = #100000 1'b0;
end 

// MemWrite
initial
begin
	MemWrite = 1'b0;
	MemWrite = #250000 1'b1;
	MemWrite = #100000 1'b0;
end 
// beq_sw[ 3 ]
initial
begin
	beq_sw[3] = 1'b0;
end 
// beq_sw[ 2 ]
initial
begin
	beq_sw[2] = 1'b0;
end 
// beq_sw[ 1 ]
initial
begin
	beq_sw[1] = 1'b0;
end 
// beq_sw[ 0 ]
initial
begin
	beq_sw[0] = 1'b0;
	beq_sw[0] = #1000000 1'b1;
end 

PC_vlg_sample_tst tb_sample (
	.MemWrite(MemWrite),
	.RegWrite(RegWrite),
	.beq_sw(beq_sw),
	.clk(clk),
	.instruction_A(instruction_A),
	.rst(rst),
	.sampler_tx(sampler)
);

PC_vlg_check_tst tb_out(
	.data_probe_segments(data_probe_segments),
	.data_probe_value(data_probe_value),
	.reg_probe_segments(reg_probe_segments),
	.reg_probe_value(reg_probe_value),
	.sampler_rx(sampler)
);
endmodule

