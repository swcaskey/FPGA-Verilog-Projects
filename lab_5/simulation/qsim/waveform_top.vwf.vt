endmodule

module top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg rst;
reg [2:0] sw;
// wires                                               
wire [31:0] ALUResult;
wire [6:0] HEX0;
wire [6:0] HEX1;
wire [6:0] HEX2;
wire [6:0] HEX3;
wire [6:0] HEX4;
wire [6:0] HEX5;
wire [31:0] RD1;
wire [31:0] RD2;
wire [31:0] prode;
wire [31:0] prode_register_file;

wire sampler;                             

// assign statements (if any)                          
top i1 (
// port map - connection between master ports and signals/registers   
	.ALUResult(ALUResult),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.RD1(RD1),
	.RD2(RD2),
	.clk(clk),
	.prode(prode),
	.prode_register_file(prode_register_file),
	.rst(rst),
	.sw(sw)
);

// clk
always
begin
	clk = 1'b0;
	clk = #25000 1'b1;
	#25000;
end 
// sw[ 2 ]
initial
begin
	sw[2] = 1'b0;
	sw[2] = #700000 1'b1;
	sw[2] = #100000 1'b0;
end 
// sw[ 1 ]
initial
begin
	sw[1] = 1'b0;
	sw[1] = #300000 1'b1;
	sw[1] = #100000 1'b0;
	sw[1] = #100000 1'b1;
	sw[1] = #100000 1'b0;
end 
// sw[ 0 ]
initial
begin
	sw[0] = 1'b0;
	sw[0] = #100000 1'b1;
	sw[0] = #100000 1'b0;
	sw[0] = #300000 1'b1;
	sw[0] = #100000 1'b0;
end 

// rst
initial
begin
	rst = 1'b0;
	rst = #50000 1'b1;
end 

top_vlg_sample_tst tb_sample (
	.clk(clk),
	.rst(rst),
	.sw(sw),
	.sampler_tx(sampler)
);

top_vlg_check_tst tb_out(
	.ALUResult(ALUResult),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.RD1(RD1),
	.RD2(RD2),
	.prode(prode),
	.prode_register_file(prode_register_file),
	.sampler_rx(sampler)
);
endmodule

